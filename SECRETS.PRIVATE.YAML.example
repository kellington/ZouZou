# =============================================================
# SECRETS.PRIVATE.YAML
# Local scratchpad for credentials, IDs, and captured values within
# the project.
#
# NOT the deployed secret store. For anything that ships, use a cloud
# Secret Manager or the platform's own secrets (Replit Secrets, GitHub
# Actions secrets, etc.).
#
# Copy this to SECRETS.PRIVATE.YAML — that name is gitignored, this one
# (.example) is tracked and must stay free of real values.
#
# Confirm with `git check-ignore -v SECRETS.PRIVATE.YAML` before writing
# anything real into it. A copied template has been committed before.
# =============================================================

project:

  # No auth in ZouZou — the "test account" is just a player name.
  test-player:
    name: zz-test   # rows written with this name get deleted (remote D1 — Rob's OK)

  # Service credentials, API keys, account IDs, console URLs
  cloudflare:
    account_id: <id>
    zone: minus1over12.com
    worker: zouzou
    d1_database_id: <from `wrangler d1 create zouzou`>
    console: https://dash.cloudflare.com/<account_id>/workers/services/view/zouzou

  replit:
    repl: <repl url>
    deployment: https://zouzou-and-friends.replit.app
    # REPLIT_DB_URL is a full-access token — don't paste it here unless needed, never echo it
