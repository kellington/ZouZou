{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zouzou", // must equal the dashboard Worker name
  "main": "./artifacts/worker/src/index.ts",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./artifacts/zouzou-friends/dist/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zouzou",
      "database_id": "25d21c9d-be53-4eb2-a819-5e7b0ae9c078", // remote D1 zouzou, WNAM, created 2026-09-17
      "migrations_dir": "./artifacts/worker/migrations"
    }
  ],
  "observability": { "enabled": true } // Workers Logs
}
